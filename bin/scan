#!/usr/bin/env php
<?php
declare(strict_types=1);

/**
 * Обход медиатеки и обновление индекса.
 *
 *   bin/scan            инкрементально (по size+mtime) — секунды
 *   bin/scan --full     перечитать всё заново, включая теги
 *   bin/scan --quiet    без прогресса, для таймера
 */

require __DIR__ . '/../src/bootstrap.php';

use App\Support\Db;
use App\Track\Scanner;

$opts  = array_slice($argv, 1);
$full  = in_array('--full', $opts, true);
$quiet = in_array('--quiet', $opts, true);

Db::migrate('tracks');

$t0 = microtime(true);
$log = static function (string $msg) use ($quiet): void {
    if (!$quiet) {
        echo $msg, "\n";
    }
};

$log($full ? 'Полное сканирование медиатеки...' : 'Инкрементальное сканирование...');

$scanner = new Scanner($log);

try {
    $stats = $scanner->run($full);
} catch (Throwable $e) {
    fwrite(STDERR, 'Сканирование упало: ' . $e->getMessage() . "\n");
    exit(1);
}

$soft = $scanner->softDuplicateCount();
$secs = round(microtime(true) - $t0, 1);

$summary = sprintf(
    "Готово за %s с: просмотрено %d, добавлено %d, обновлено %d, без изменений %d, "
    . "пропало %d, ошибок %d, байтовых дублей %d",
    $secs, $stats['scanned'], $stats['added'], $stats['updated'],
    $stats['unchanged'], $stats['removed'], $stats['failed'], $stats['duplicates']
);

if ($quiet) {
    // В таймере пишем только если что-то изменилось
    if ($stats['added'] || $stats['updated'] || $stats['removed'] || $stats['failed']) {
        echo $summary, "\n";
    }
} else {
    echo $summary, "\n";
    if ($soft > 0) {
        echo "Возможных дублей по «артист+название+длительность»: $soft "
           . "(в ротации оставлены, автоматически не трогаем)\n";
    }
}

/*
 * Атрибуция одобренных загрузок.
 *
 * Upload\Service::approve() копирует файл в upload/ и запускает этот
 * скрипт заново, но асинхронно (nohup &) — синхронно схватить id новой
 * записи tracks оттуда нельзя. Поэтому находим его здесь, сразу после
 * собственного прохода Scanner: путь уже известен (upload/<stored_name>),
 * остаётся только сопоставить. Условие "approved_track_id IS NULL"
 * делает шаг идемпотентным и самовосстанавливающимся — если по какой-то
 * причине бэкфилл не отработал сразу, следующий проход (хоть ручной,
 * хоть по таймеру раз в 15 минут) досчитает его.
 */
Db::migrate('uploads');
$pending = Db::get('uploads');
$tracksDb = Db::get('tracks');

$rows = $pending->query(
    "SELECT id, stored_name, user_id, username FROM pending_uploads
     WHERE status = 'approved' AND approved_track_id IS NULL"
)->fetchAll();

foreach ($rows as $r) {
    $path = '/upload/' . $r['stored_name'];
    $find = $tracksDb->prepare('SELECT id FROM tracks WHERE path = ?');
    $find->execute([$path]);
    $trackId = $find->fetchColumn();

    if ($trackId === false) {
        continue;   // файл ещё не подхвачен этим же проходом — досчитается в следующий раз
    }

    $tracksDb->prepare('UPDATE tracks SET uploader_user_id = ?, uploader_username = ? WHERE id = ?')
        ->execute([$r['user_id'], $r['username'], $trackId]);
    $pending->prepare('UPDATE pending_uploads SET approved_track_id = ? WHERE id = ?')
        ->execute([(int) $trackId, $r['id']]);

    $log("Атрибуция: трек #$trackId -> {$r['username']}");
}
