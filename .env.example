# RandomMusic v2 — окружение. Файл НЕ в git.
#
# ВАЖНО: chmod 640, владелец faust_z, группа faust_z.
# Веб работает под faust_z-www (входит в группу faust_z). При 600 файл
# читается только из CLI, а веб молча берёт значения по умолчанию —
# включая подпись токенов формы. Проверить: /api/v1/health
APP_ENV=prod
APP_DEBUG=0

# Пути
DOCROOT=/home/faust_z/public_html/randommusic.insomnia247.nl
VAR_DIR=/home/faust_z/apps/randommusic/var

# Медиатека: каталоги внутри DOCROOT, через запятую
MEDIA_DIRS=1000,music,upload

# Инструменты
FFPROBE=/usr/bin/ffprobe
FFMPEG=/usr/bin/ffmpeg

# Секреты
ADMIN_TOKEN=
CLIENT_SALT=

# Telegram (перевыпустить токен через @BotFather и вписать сюда)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Аналитика. Яндекс Метрика: номер счётчика с metrika.yandex.ru.
# Пусто — счётчик не подключается вовсе.
METRIKA_ID=
METRIKA_WEBVISOR=1

# DonationAlerts. Последний донат показывается на главной.
# Один раз: завести приложение на
# https://www.donationalerts.com/application/clients (Redirect URI =
# DONATIONALERTS_REDIRECT_URI), вписать client_id/secret ниже и выполнить
# bin/donations-auth. Токены сохранятся в var/db/donations.sqlite —
# значения ACCESS/REFRESH ниже нужны лишь как резерв.
# Пустой CLIENT_ID — фича спит, наружу ничего не ходит.
DONATIONALERTS_URL=https://www.donationalerts.com/r/faust_z
DONATIONALERTS_CLIENT_ID=
DONATIONALERTS_CLIENT_SECRET=
DONATIONALERTS_REDIRECT_URI=http://localhost
DONATIONALERTS_ACCESS_TOKEN=
DONATIONALERTS_REFRESH_TOKEN=

# Антиспам чата
CHAT_RATE_PER_3S=1
CHAT_RATE_PER_MIN=10
CHAT_RATE_PER_HOUR=100
CHAT_MAX_LEN=256
CHAT_MAX_NAME=32

# Аккаунты — только для доступа к /upload, без email и восстановления пароля
SESSION_TTL_DAYS=180
AUTH_USERNAME_MIN=3
AUTH_USERNAME_MAX=20
AUTH_PASSWORD_MIN=8
AUTH_RATE_REGISTER_PER_HOUR=5
AUTH_RATE_LOGIN_PER_HOUR=10

# Загрузки пользователей. Файл до одобрения лежит в var/uploads/pending/
# (вне docroot, вне MEDIA_DIRS — Track\Scanner его не видит). Одобренные
# копируются в upload/ и подхватываются обычным сканированием.
# upload_max_filesize/post_max_size в PHP тоже нужно поднять — см.
# public/.user.ini и раздел README про загрузки (есть нюанс с mod_php).
UPLOAD_MAX_BYTES=26214400
UPLOAD_MAX_DURATION_SECONDS=7200
UPLOAD_RATE_PER_DAY=5
UPLOAD_MAX_PENDING_PER_USER=1
